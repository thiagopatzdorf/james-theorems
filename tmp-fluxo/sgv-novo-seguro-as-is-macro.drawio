ntryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n20" target="n22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="302"/></Array></mxGeometry></mxCell><mxCell id="e40" value="WhatsApp" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n22" target="n23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1495" y="302"/><mxPoint x="1495" y="260"/></Array></mxGeometry></mxCell><mxCell id="e41" value="Ligação" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n22" target="n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="345"/></Array></mxGeometry></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1708" y="260"/><mxPoint x="1708" y="471"/></Array></mxGeometry></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n24" target="n25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1928" y="471"/><mxPoint x="1928" y="302"/></Array></mxGeometry></mxCell><mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2148" y="302"/><mxPoint x="2148" y="624"/></Array></mxGeometry></mxCell><mxCell id="e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2155" y="345"/><mxPoint x="2155" y="624"/></Array></mxGeometry></mxCell><mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n27" target="n28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e47" value="sim, volta para a negociação" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n28" target="n19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2480" y="708"/><mxPoint x="940" y="708"/></Array></mxGeometry></mxCell><mxCell id="e48" value="não" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n29" target="n30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2808" y="624"/><mxPoint x="2808" y="773"/></Array></mxGeometry></mxCell><mxCell id="e50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n30" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3248" y="773"/><mxPoint x="3248" y="917"/></Array></mxGeometry></mxCell><mxCell id="e52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n32" target="n33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e53" value="próximo ciclo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n33" target="n30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3580" y="975"/><mxPoint x="2920" y="975"/></Array></mxGeometry></mxCell><mxCell id="n54" value="Medido e informado pelo time&lt;br&gt;• Se a negociação for por ligação, não há contrato para assinar; por WhatsApp sempre há.&lt;br&gt;• O detalhe da renovação está em sgv-renovacao-seguros-as-is-v7.&lt;br&gt;• Se a emissão passar de 5 dias ou a vistoria for recusada, o processo volta para a negociação." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="24" y="1061" width="3662" height="88" as="geometry"/></mxCell><mxCell id="n55" value="A confirmar&lt;br&gt;• Quem faz a vistoria (a seguradora, uma empresa parceira ou o próprio cliente)? É ela que recusa?&lt;br&gt;• A cotação do seguro novo é feita em quais portais? Quantas seguradoras por pedido? Quanto tempo leva?&lt;br&gt;• Lead do Salesforce e pedido da agência entram no mesmo processo do Fluid, ou são processos diferentes?&lt;br&gt;• O seguro novo dispara o RPA | Aviso de Renovação só na renovação, ou também algum aviso ao fechar?&lt;br&gt;• O &quot;esperar 1 ano&quot; é só o dash do Power BI ou existe um agendamento? Quem garante que nenhuma apólice some do dash?&lt;br&gt;• Quando a emissão devolve o processo para a negociação, volta para o mesmo operador?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="24" y="1165" width="3662" height="142" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
