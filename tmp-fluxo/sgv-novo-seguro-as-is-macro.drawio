<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="genesis-fluxo" fluxo-fonte="" version="1.0"><diagram id="fluxo" name="SGV · Novo seguro + ciclo de renovação — AS IS macro"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="SGV · Novo seguro + ciclo de renovação — AS IS macro" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="3662" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Visão macro do que acontece hoje, do pedido da agência (ou lead do Salesforce) até a apólice emitida, e como o Denodo guarda o ano da renovação para o fluxo de renovação começar cerca de 40 dias antes de vencer. A cotação do seguro novo é manual; a negociação, a assinatura e a emissão seguem o mesmo caminho da renovação. Pontos em &quot;A confirmar&quot; ainda não foram validados." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="24" y="50" width="3662" height="36" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="3710" height="110" as="geometry"/></mxCell><mxCell id="n5" value="Origem do pedido" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="150" height="110" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="206" width="3710" height="192" as="geometry"/></mxCell><mxCell id="n7" value="Operador Seguros" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="206" width="150" height="192" as="geometry"/></mxCell><mxCell id="n8" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="398" width="3710" height="146" as="geometry"/></mxCell><mxCell id="n9" value="Cliente" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="398" width="150" height="146" as="geometry"/></mxCell><mxCell id="n10" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="544" width="3710" height="160" as="geometry"/></mxCell><mxCell id="n11" value="Fluid (assinaturas, vistoria e emissão)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="544" width="150" height="160" as="geometry"/></mxCell><mxCell id="n12" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="704" width="3710" height="137" as="geometry"/></mxCell><mxCell id="n13" value="Denodo / Dremio / Power BI" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="704" width="150" height="137" as="geometry"/></mxCell><mxCell id="n14" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="841" width="3710" height="152" as="geometry"/></mxCell><mxCell id="n15" value="Fluxo de renovação" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="841" width="150" height="152" as="geometry"/></mxCell><mxCell id="n16" value="Agência pede um contrato (seguro novo) ou chega um lead no Salesforce" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="185" y="116" width="190" height="71" as="geometry"/></mxCell><mxCell id="n17" value="Recebe o pedido e abre o processo no Fluid" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="413" y="270" width="175" height="64" as="geometry"/></mxCell><mxCell id="n18" value="Faz a cotação à mão (sem robô), nas seguradoras" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="633" y="267" width="175" height="71" as="geometry"/></mxCell><mxCell id="n19" value="Apresenta a cotação ao cliente" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="853" y="270" width="175" height="64" as="geometry"/></mxCell><mxCell id="n20" value="Cliente aceitou?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="1065" y="416" width="190" height="110" as="geometry"/></mxCell><mxCell id="n21" value="Negócio perdido (processo encerrado)" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1285" y="439" width="190" height="64" as="geometry"/></mxCell><mxCell id="n22" value="Canal da negociação?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="1285" y="247" width="190" height="110" as="geometry"/></mxCell><mxCell id="n23" value="Envia o contrato para assinatura (RPA | Envio Assinaturas)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1513" y="224" width="175" height="71" as="geometry"/></mxCell><mxCell id="n24" value="Assina o contrato" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1733" y="439" width="175" height="64" as="geometry"/></mxCell><mxCell id="n25" value="Monitora a assinatura (RPA | Monitoramento Assinaturas)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1953" y="267" width="175" height="71" as="geometry"/></mxCell><mxCell id="n26" value="Negocia por ligação (não há contrato para assinar)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1513" y="309" width="175" height="71" as="geometry"/></mxCell><mxCell id="n27" value="Vistoria do bem" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="2173" y="592" width="175" height="64" as="geometry"/></mxCell><mxCell id="n28" value="Vistoria recusada ou emissão passou de 5 dias?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="2385" y="562" width="190" height="124" as="geometry"/></mxCell><mxCell id="n29" value="Emissão da apólice (RPA | Emissão de Apólices)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2613" y="589" width="175" height="71" as="geometry"/></mxCell><mxCell id="n30" value="Apólice efetivada entra no Denodo com a data de renovação (mesmo dado que alimenta o dash)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2833" y="722" width="175" height="101" as="geometry"/></mxCell><mxCell id="n31" value="Espera cerca de 1 ano, até faltar ~40 dias para o fim da vigência" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#052E16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3053" y="737" width="175" height="71" as="geometry"/></mxCell><mxCell id="n32" value="Abre o lote de renovação (dash do Power BI, Fluid, filas do UiPath, cotação por robô, negociação, emissão)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3273" y="859" width="175" height="116" as="geometry"/></mxCell><mxCell id="n33" value="Renovação emitida: nova data de renovação volta ao Denodo" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3493" y="882" width="175" height="71" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPo