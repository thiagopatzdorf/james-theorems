<mxfile host="genesis-fluxo" version="1.0"><diagram id="fluxo" name="Renovação de seguros (residencial e auto) — AS IS"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Renovação de seguros (residencial e auto) — AS IS" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="3517" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Como o processo roda hoje, levantado em 15/10/2026 com quem opera. O que está em &quot;A confirmar&quot; ainda não foi validado." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="24" y="50" width="3517" height="36" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="3565" height="122" as="geometry"/></mxCell><mxCell id="n5" value="Adri (assessora de seguros)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="150" height="122" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="218" width="3565" height="110" as="geometry"/></mxCell><mxCell id="n7" value="Operador" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="218" width="150" height="110" as="geometry"/></mxCell><mxCell id="n8" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="328" width="3565" height="110" as="geometry"/></mxCell><mxCell id="n9" value="Fluid · RPA | Baixa de Apólices" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="328" width="150" height="110" as="geometry"/></mxCell><mxCell id="n10" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="438" width="3565" height="146" as="geometry"/></mxCell><mxCell id="n11" value="Robô UiPath" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="438" width="150" height="146" as="geometry"/></mxCell><mxCell id="n12" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="584" width="3565" height="122" as="geometry"/></mxCell><mxCell id="n13" value="Pasta de rede (UNC)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="584" width="150" height="122" as="geometry"/></mxCell><mxCell id="n14" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="706" width="3565" height="110" as="geometry"/></mxCell><mxCell id="n15" value="Fluid · RPA | Cotação de Seguros" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="706" width="150" height="110" as="geometry"/></mxCell><mxCell id="n16" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="816" width="3565" height="110" as="geometry"/></mxCell><mxCell id="n17" value="Crítica" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="816" width="150" height="110" as="geometry"/></mxCell><mxCell id="n18" value="Lote de ~1.000 processos a vencer, cerca de 40 dias antes (residencial e auto, 5 seguradoras)" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="183" y="114" width="200" height="86" as="geometry"/></mxCell><mxCell id="n19" value="Importa o lote no Fluid" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="413" y="125" width="190" height="64" as="geometry"/></mxCell><mxCell id="n20" value="Processos abertos na instância RPA | Baixa de Apólices" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="638" y="348" width="190" height="71" as="geometry"/></mxCell><mxCell id="n21" value="Aciona o robô alimentador (passo manual)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="863" y="238" width="190" height="71" as="geometry"/></mxCell><mxCell id="n22" value="Alimenta a fila do UiPath com os processos" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1088" y="479" width="190" height="64" as="geometry"/></mxCell><mxCell id="n23" value="Para cada item da fila: abre a tela da seguradora e baixa a apólice" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1313" y="468" width="190" height="86" as="geometry"/></mxCell><mxCell id="n24" value="Conseguiu baixar a apólice?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="1533" y="456" width="200" height="110" as="geometry"/></mxCell><mxCell id="n25" value="Tem endosso ou sinistro?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="1758" y="456" width="200" height="110" as="geometry"/></mxCell><mxCell id="n26" value="PDF salvo como &quot;Nome do segurado + Nº da apólice&quot; (endosso não é baixado)" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#052E16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1988" y="602" width="190" height="86" as="geometry"/></mxCell><mxCell id="n27" value="Depois de baixar tudo: anexa o PDF da apólice no Fluid (via API)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2213" y="476" width="190" height="71" as="geometry"/></mxCell><mxCell id="n28" value="Lê o campo da apólice com os dados do ano passado (URL do Fluid do ano anterior)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2438" y="468" width="190" height="86" as="geometry"/></mxCell><mxCell id="n29" value="Abre o Fluid do ano anterior e extrai o PDF de dados do processo" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2663" y="476" width="190" height="71" as="geometry"/></mxCell><mxCell id="n30" value="Anexa o PDF de dados no Fluid (segundo documento)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2888" y="476" width="190" height="71" as="geometry"/></mxCell><mxCell id="n31" value="Protocola o Fluid para a instância RPA | Cotação de Seguros" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3113" y="476" width="190" height="71" as="geometry"/></mxCell><mxCell id="n32" value="Processo chega na instância RPA | Cotação de Seguros" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3333" y="726" width="200" height="71" as="geometry"/></mxCell><mxCell id="n33" value="Processo enviado para a crítica" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#450A0A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1988" y="839" width="190" height="64" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounde