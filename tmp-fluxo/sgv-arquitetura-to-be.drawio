"n39" target="n38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e61" value="dados do ano passado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n39" target="n23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2055" y="157"/></Array></mxGeometry></mxCell><mxCell id="e62" value="grava questionário" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n39" target="n40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2055" y="1052"/></Array></mxGeometry></mxCell><mxCell id="e63" value="logs e alarmes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="1175"/></Array></mxGeometry></mxCell><mxCell id="e64" value="alerta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n41" target="n24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="exceção" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n42"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="1175"/></Array></mxGeometry></mxCell><mxCell id="e66" value="segue para o negócio" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n42" target="n40"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="1052"/></Array></mxGeometry></mxCell><mxCell id="e67" value="PDFs e questionário" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n40" target="n25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="315" y="273"/></Array></mxGeometry></mxCell><mxCell id="e68" value="negocia" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n69" value="Medido e informado pelo time&lt;br&gt;• Hoje: baixa leva ≈3 minutos por apólice em tela, 20% das apólices e endossos vão para a crítica, e a carga do lote é instantânea (minutos). O prazo de dia 01 é do mês seguinte." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="24" y="1298" width="2752" height="70" as="geometry"/></mxCell><mxCell id="n70" value="A confirmar&lt;br&gt;• O stack AWS (agenda, fila, orquestrador, workers, vault, banco de estado e observabilidade) é proposta minha: o que o time já usa na AWS?&lt;br&gt;• Vault de senhas: já existe um (qual) ou será o gerenciador de segredos da AWS? Quem rotaciona as senhas dos portais e do sistema de cotação?&lt;br&gt;• Como o Fluid expõe a API (abrir, anexar, protocolar) e com que autenticação? O Orquestrador chama por HTTPS?&lt;br&gt;• Como o Denodo entrega ao Dremio (conexão direta ou carga) e como o Dremio é consultado pelos workers?&lt;br&gt;• O App Gateway da Pioneira: autenticação, limite de chamadas e se há ambiente de teste.&lt;br&gt;• Quem recebe o alerta quando a baixa falha depois das novas tentativas, e onde fica a trilha de auditoria?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="24" y="1384" width="2752" height="142" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
