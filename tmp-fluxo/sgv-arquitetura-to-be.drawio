 x="1388" y="122" width="175" height="71" as="geometry"/></mxCell><mxCell id="n24" value="Time de operação e TI: recebe alertas e trata falhas" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1388" y="1140" width="175" height="71" as="geometry"/></mxCell><mxCell id="n25" value="Operador Seguros: negociação (mantida como hoje)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="2258" y="238" width="175" height="71" as="geometry"/></mxCell><mxCell id="n26" value="Denodo: lake do CAS, que também alimenta a Pioneira" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#0F172A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1388" y="354" width="175" height="71" as="geometry"/></mxCell><mxCell id="n27" value="App Gateway da Pioneira: APIs de baixa, vencidos, endossos e renovações" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#0F172A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1098" y="346" width="175" height="86" as="geometry"/></mxCell><mxCell id="n28" value="Gateway de WhatsApp: aviso de renovação e negociação" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#0F172A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2258" y="354" width="175" height="71" as="geometry"/></mxCell><mxCell id="n29" value="Gateway de e-mail: monitora a recusa da vistoria" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#0F172A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2548" y="354" width="175" height="71" as="geometry"/></mxCell><mxCell id="n30" value="Agendador (proposta: EventBridge): rotina diária de consultas" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="518" y="483" width="175" height="71" as="geometry"/></mxCell><mxCell id="n31" value="Filas (proposta: SQS): baixa, questionário, cotação e avisos, com fila de exceção" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontSize=12;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#042F2E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="800" y="476" width="190" height="86" as="geometry"/></mxCell><mxCell id="n32" value="Orquestrador (proposta: Step Functions): fluxo por apólice, novas tentativas e prazos" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1098" y="468" width="175" height="101" as="geometry"/></mxCell><mxCell id="n33" value="Workers de integração (proposta: containers ou Lambda): baixa, Fluid, S3, IA" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1678" y="476" width="175" height="86" as="geometry"/></mxCell><mxCell id="n34" value="Robôs de cotação (Playwright ou Selenium em containers na AWS)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1098" y="605" width="175" height="86" as="geometry"/></mxCell><mxCell id="n35" value="Sistema de cotação (acesso por tela, 90+ seletores)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#0F172A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2548" y="613" width="175" height="71" as="geometry"/></mxCell><mxCell id="n36" value="Vault de senhas (proposta: Secrets Manager): credenciais de gateway, Fluid, cotação e canais" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2258" y="727" width="175" height="101" as="geometry"/></mxCell><mxCell id="n37" value="Estado por apólice (proposta: banco gerenciado): idempotência e auditoria" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1388" y="727" width="175" height="101" as="geometry"/></mxCell><mxCell id="n38" value="S3: PDFs das apólices, endossos e questionários" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#052E16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1388" y="879" width="175" height="71" as="geometry"/></mxCell><mxCell id="n39" value="IA integrada: lê a apólice e os dados do ano passado e monta o questionário de 15 perguntas" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1968" y="864" width="175" height="101" as="geometry"/></mxCell><mxCell id="n40" value="Fluid: abertura automática 1 ano antes, anexos, instâncias e protocolo (API)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="228" y="1001" width="175" height="101" as="geometry"/></mxCell><mxCell id="n41" value="Observabilidade (proposta: logs, métricas e alarmes)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1098" y="1140" width="175" height="71" as="geometry"/></mxCell><mxCell id="n42" value="Crítica: fila de exceção (falha de baixa ou de cotação)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#450A0A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="518" y="1140" width="175" height="71" as="geometry"/></mxCell><mxCell id="e43" value="carga" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n26" target="n23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e44" value="consulta" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e45" value="evento diário" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n30" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e46" value="por apólice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e47" value="API de baixa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;e