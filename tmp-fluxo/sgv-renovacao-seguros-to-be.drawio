<mxfile host="genesis-fluxo" version="1.0"><diagram id="fluxo" name="SGV · Renovação de seguros — TO BE (engenharia)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="SGV · Renovação de seguros — TO BE (engenharia)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="3662" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Proposta levantada em 15/10/2026. Fase 1 = [F1]: baixar toda a base, consultas diárias (vencidos, endossos emitidos, renovações), apólices no S3, o próprio sistema abre os Fluids com 1 ano de antecedência e dashes de gestão. [Depois] = cotação em Playwright/Selenium na AWS e gateways de WhatsApp e e-mail, ainda sem fase definida. A negociação com o cliente fica como hoje (manual, fora do escopo agora). Pontos em &quot;A confirmar&quot; ainda não foram validados." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="24" y="50" width="3662" height="36" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="3710" height="122" as="geometry"/></mxCell><mxCell id="n5" value="Dremio" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="150" height="122" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="218" width="3710" height="152" as="geometry"/></mxCell><mxCell id="n7" value="Orquestrador SGV (AWS)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="218" width="150" height="152" as="geometry"/></mxCell><mxCell id="n8" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="370" width="3710" height="122" as="geometry"/></mxCell><mxCell id="n9" value="App Gateway da Pioneira" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="370" width="150" height="122" as="geometry"/></mxCell><mxCell id="n10" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="492" width="3710" height="110" as="geometry"/></mxCell><mxCell id="n11" value="S3" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="492" width="150" height="110" as="geometry"/></mxCell><mxCell id="n12" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="602" width="3710" height="146" as="geometry"/></mxCell><mxCell id="n13" value="Fluid" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="602" width="150" height="146" as="geometry"/></mxCell><mxCell id="n14" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="748" width="3710" height="137" as="geometry"/></mxCell><mxCell id="n15" value="IA integrada" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="748" width="150" height="137" as="geometry"/></mxCell><mxCell id="n16" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="885" width="3710" height="146" as="geometry"/></mxCell><mxCell id="n17" value="Cotação (Playwright ou Selenium, AWS)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="885" width="150" height="146" as="geometry"/></mxCell><mxCell id="n18" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1031" width="3710" height="122" as="geometry"/></mxCell><mxCell id="n19" value="Gateways de WhatsApp e e-mail" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1031" width="150" height="122" as="geometry"/></mxCell><mxCell id="n20" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1153" width="3710" height="122" as="geometry"/></mxCell><mxCell id="n21" value="Operador Seguros (negócio, mantido)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1153" width="150" height="122" as="geometry"/></mxCell><mxCell id="n22" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1275" width="3710" height="152" as="geometry"/></mxCell><mxCell id="n23" value="Dashes de gestão e métricas" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1275" width="150" height="152" as="geometry"/></mxCell><mxCell id="n24" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1427" width="3710" height="122" as="geometry"/></mxCell><mxCell id="n25" value="Crítica" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1427" width="150" height="122" as="geometry"/></mxCell><mxCell id="n26" value="[F1] Carga inicial: baixa toda a base de apólices (efetivadas e renovadas)" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="185" y="114" width="190" height="86" as="geometry"/></mxCell><mxCell id="n27" value="[F1] Lê a base no Dremio e abre os Fluids sozinho, 1 ano antes do vencimento (sem importar lote na mão)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="413" y="236" width="175" height="116" as="geometry"/></mxCell><mxCell id="n28" value="[F1] Fluid aberto: um por apólice, 1 ano de antecedência" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="633" y="640" width="175" height="71" as="geometry"/></mxCell><mxCell id="n29" value="[F1] Pede a baixa da apólice pelas APIs de baixa" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="853" y="259" width="175" height="71" as="geometry"/></mxCell><mxCell id="n30" value="[F1] API de baixa devolve o PDF da apólice" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1073" y="396" width="175" height="71" as="geometry"/></mxCell><mxCell id="n31" value="Baixou a apólice?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="1285" y="239" width="190" height="110" as="geometry"/></mxCell><mxCell id="n32" value="[F1] PDF da apólice salvo no S3 (segurado + nº da apólice)" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#052E16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1513" y="512" width="175" height="71" as="geometry"/></mxCell><mxCell id="n33" value="[F1] Link do S3 anexado ao Fluid (API)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1733" y="643" width="175" height="64" as="geometry"/></mxCell><mxCell id="n34" value="[F1] Rotina diária agendada: consulta o que mudou" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1953" y="259" width="175" height="71" as="geometry"/></mxCell><mxCell id="n35" value="[F1] Lista os seguros que venceram, os endossos emitidos e as renovações do dia" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2173" y="388" width="175" height="86" as="geometry"/></mxCell><mxCell id="n36" value="Seguro foi renovado?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="2385" y="239" width="190" height="110" as="geometry"/></mxCell><mxCell id="n37" value="[F1] Atualiza o Fluid: seguro vencido ou endosso emitido (o endosso vira dado, não crítica)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2613" y="625" width="175" height="101" as="geometry"/></mxCell><mxCell id="n38" value="[F1] IA lê a apólice (S3) e os dados do ano passado (Dremio) e monta o questionário de 15 perguntas" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1733" y="766" width="175" height="101" as="geometry"/></mxCell><mxCell id="n39" value="[F1] Questionário gravado no Fluid" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1953" y="643" width="175" height="64" as="geometry"/></mxCell><mxCell id="n40" value="[F1] Dashes de acompanhamento e métricas: Fluids abertos, apólices baixadas, taxa de crítica, tempo" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2825" y="1293" width="190" height="116" as="geometry"/></mxCell><mxCell id="n41" value="[Depois] Robô Playwright ou Selenium na AWS preenche a cotação em tela (90+ seletores)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2173" y="908" width="175" height="101" as="geometry"/></mxCell><mxCell id="n42" value="Cotação concluída com sucesso?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="2385" y="903" width="190" height="110" as="geometry"/></mxCell><mxCell id="n43" value="[Depois] Gateway de WhatsApp: aviso de renovação (faltam 10 dias)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2613" y="1049" width="175" height="86" as="geometry"/></mxCell><mxCell id="n44" value="[Depois] Gateway de e-mail: monitora a recusa da vistoria" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="185" y="1057" width="190" height="71" as="geometry"/></mxCell><mxCell id="n45" value="Negociação com o cliente por WhatsApp ou ligação (negócio mantido como hoje)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="2833" y="1171" width="175" height="86" as="geometry"/></mxCell><mxCell id="n46" value="Emissão de Apólices: aguarda a emissão" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3053" y="643" width="175" height="64" as="geometry"/></mxCell><mxCell id="n47" value="Passou de 5 dias ou chegou recusa da vistoria?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="3265" y="620" width="190" height="110" as="geometry"/></mxCell><mxCell id="n48" value="Nº da apólice nova entra no Dremio (ciclo do ano que vem)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3493" y="122" width="175" height="71" as="geometry"/></mxCell><mxCell id="n49" value="Crítica: falha de baixa ou de cotação (hoje ≈20% das apólices e endossos)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#450A0A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2613" y="1445" width="175" height="86" as="geometry"/