<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="genesis-fluxo" version="1.0"><diagram id="fluxo" name="SGV · Renovação de seguros (residencial e auto) — AS IS v3"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="SGV · Renovação de seguros (residencial e auto) — AS IS v3" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="5422" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Versão 3, com as correções de 15/10/2026. Tudo roda por evento e em paralelo. A baixa da apólice e a consulta dos dados do ano passado (fila de Questionário) não dependem uma da outra. O agente de IA está fora da sequência e só lê os PDFs (seta tracejada = leitura de dado). A crítica segue para o negócio, e o ano fecha um ciclo no Dremio. Tracejado em âmbar = manual. Pontos em &quot;A confirmar&quot; ainda não foram validados." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="24" y="50" width="5422" height="36" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="5470" height="110" as="geometry"/></mxCell><mxCell id="n5" value="Denodo (lake do CAS, alimenta a Pioneira)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="150" height="110" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="206" width="5470" height="110" as="geometry"/></mxCell><mxCell id="n7" value="Dremio" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F