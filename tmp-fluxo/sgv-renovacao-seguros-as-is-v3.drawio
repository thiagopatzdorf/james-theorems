;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="825" width="5470" height="146" as="geometry"/></mxCell><mxCell id="n17" value="Robô UiPath · alimentador" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="825" width="150" height="146" as="geometry"/></mxCell><mxCell id="n18" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="971" width="5470" height="192" as="geometry"/></mxCell><mxCell id="n19" value="UiPath · filas" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="971" width="150" height="192" as="geometry"/></mxCell><mxCell id="n20" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1163" width="5470" height="146" as="geometry"/></mxCell><mxCell id="n21" value="Robô UiPath · baixa da apólice" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1163" width="150" height="146" as="geometry"/></mxCell><mxCell id="n22" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1309" width="5470" height="200" as="geometry"/></mxCell><mxCell id="n23" value="Robô UiPath · dados do ano passado" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1309" width="150" height="200" as="geometry"/></mxCell><mxCell id="n24" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1509" width="5470" height="122" as="geometry"/></mxCell><mxCell id="n25" value="Pasta de rede (UNC)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1509" width="150" height="122" as="geometry"/></mxCell><mxCell id="n26" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1631" width="5470" height="137" as="geometry"/></mxCell><mxCell id="n27" value="Agente de IA (independente, por evento)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1631" width="150" height="137" as="geometry"/></mxCell><mxCell id="n28" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1768" width="5470" height="110" as="geometry"/></mxCell><mxCell id="n29" value="Operação de negócio" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1768" width="150" height="110" as="geometry"/></mxCell><mxCell id="n30" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1878" width="5470" height="122" as="geometry"/></mxCell><mxCell id="n31" value="Crítica" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1878" width="150" height="122" as="geometry"/></mxCell><mxCell id="n32" value="Seguros efetivados no ano anterior ou renovados" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="185" y="116" width="190" height="71" as="geometry"/></mxCell><mxCell id="n33" value="Consome os dados do Denodo e entrega ao Power BI" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="413" y="226" width="175" height="71" as="geometry"/></mxCell><mxCell id="n34" value="Dash com os ~1.000 processos a vencer, cerca de 40 dias antes (auto e residencial, 5 seguradoras)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="633" y="334" width="175" height="101" as="geometry"/></mxCell><mxCell id="n35" value="Dia 20 abre o lote: importa os ~1.000 processos no Fluid" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="853" y="473" width="175" height="71" as="geometry"/></mxCell><mxCell id="n36" value="Processos abertos em RPA | Baixa de Apólices (prazo: tudo baixado e nas instâncias certas até dia 01)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1073" y="691" width="175" height="116" as="geometry"/></mxCell><mxCell id="n37" value="Aciona o robô alimentador (passo manual)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1293" y="583" width="175" height="71" as="geometry"/></mxCell><mxCell id="n38" value="Alimenta as 3 filas ao mesmo tempo com final da vigência, nome do segurado e seguradora" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1513" y="855" width="175" height="86" as="geometry"/></mxCell><mxCell id="n39" value="Seguradora é Porto Seguro e o produto é Auto?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="1725" y="843" width="190" height="110" as="geometry"/></mxCell><mxCell id="n40" value="Produto é Auto ou Residencial?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="1945" y="843" width="190" height="110" as="geometry"/></mxCell><mxCell id="n41" value="Fila BaixaApoliceRenovacaoSeguroAuto" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontSize=12;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#042F2E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2165" y="989" width="190" height="71" as="geometry"/></mxCell><mxCell id="n42" value="Fila BaixaApoliceRenovacaoSeguroResidencial" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontSize=12;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#042F2E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2165" y="1074" width="190" height="71" as="geometry"/></mxCell><mxCell id="n43" value="Fila QuestionarioRenovacaoSeguros (dados do ano passado)" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontSize=12;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#042F2E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1725" y="1024" width="190" height="86" as="geometry"/></mxCell><mxCell id="n44" value="Para cada item da fila: abre a tela da seguradora e baixa a apólice" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2393" y="1193" width="175" height="86" as="geometry"/></mxCell><mxCell id="n45" value="Conseguiu baixar a apólice?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="2605" y="1181" width="190" height="110" as="geometry"/></mxCell><mxCell id="n46" value="Tem endosso ou sinistro?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="2825" y="1181" width="190" height="110" as="geometry"/></mxCell><mxCell id="n47" value="PDF salvo como &quot;Nome do segurado + Nº da apólice&quot; (endosso não é baixado)" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#052E16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3053" y="1527" width="175" height="86" as="geometry"/></mxCell><mxCell id="n48" value="Depois de baixar tudo: anexa o PDF da apólice no Fluid (via API)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3273" y="1201" width="175" height="71" as="geometry"/></mxCell><mxCell id="n49" value="Para cada item da fila: lê o campo da apólice com os dados do ano passado (URL do Fluid do ano anterior)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1953" y="1359" width="175" height="101" as="geometry"/></mxCell><mxCell id="n50" value="Achou o processo do ano anterior?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="2165" y="1354" width="190" height="110" as="geometry"/></mxCell><mxCell id="n51" value="Extrai o PDF de dados do processo do ano anterior e anexa no Fluid" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2393" y="1327" width="175" height="86" as="geometry"/></mxCell><mxCell id="n52" value="Anexa um PDF em branco no Fluid" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2393" y="1427" width="175" height="64" as="geometry"/></mxCell><mxCell id="n53" value="Protocola o Fluid para RPA | Cotação de Seguros" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3493" y="1201" width="175" height="71" as="geometry"/></mxCell><mxCell id="n54" value="Lê o PDF da apólice e o PDF de dados do ano passado e monta o questionário de 15 perguntas" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3493" y="1649" width="175" height="101" as="geometry"/></mxCell><mxCell id="n55" value="Questionário de 15 perguntas pronto" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3705" y="1668" width="190" height="64" as="geometry"/></mxCell><mxCell id="n56" value="RPA | Cotação de Seguros: robô preenche a cotação em tela (90+ seletores; regras fixas, Fluid e apólice)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3713" y="691" width="175" height="116" as="geometry"/></mxCell><mxCell id="n57" value="Cotação concluída com sucesso?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeom