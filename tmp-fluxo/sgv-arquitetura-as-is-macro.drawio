<mxfile host="genesis-fluxo" version="1.0"><diagram id="fluxo" name="SGV · Renovação de seguros — arquitetura e sistemas (AS IS macro)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="SGV · Renovação de seguros — arquitetura e sistemas (AS IS macro)" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="2462" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Visão macro de quais sistemas e pessoas participam e o que trafega entre eles hoje. Cada raia é uma camada. Levantado em 15/10/2026 com quem opera; o que está em &quot;A confirmar&quot; ainda não foi validado. O detalhe passo a passo está no AS IS v6." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="24" y="50" width="2462" height="36" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="2510" height="137" as="geometry"/></mxCell><mxCell id="n5" value="Dados" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="150" height="137" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="233" width="2510" height="110" as="geometry"/></mxCell><mxCell id="n7" value="Pessoas" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="233" width="150" height="110" as="geometry"/></mxCell><mxCell id="n8" value="" style="round