idth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n27" target="n30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1475" y="657"/></Array></mxGeometry></mxCell><mxCell id="e47" value="salva o PDF" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n27" target="n32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1475" y="773"/></Array></mxGeometry></mxCell><mxCell id="e48" value="PDFs da apólice e de dados" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n26" target="n25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="288"/></Array></mxGeometry></mxCell><mxCell id="e49" value="chama o agente" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2055" y="895"/></Array></mxGeometry></mxCell><mxCell id="e50" value="PDF e questionário" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n34" target="n33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1765" y="773"/></Array></mxGeometry></mxCell><mxCell id="e51" value="questionário (15 perguntas)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#64748B;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n33" target="n25"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2345" y="288"/></Array></mxGeometry></mxCell><mxCell id="e52" value="negocia e contrato" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2055" y="895"/></Array></mxGeometry></mxCell><mxCell id="e53" value="negocia sem contrato" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n37"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2055" y="1011"/></Array></mxGeometry></mxCell><mxCell id="e54" value="recusa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n31" target="n36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="1011"/></Array></mxGeometry></mxCell><mxCell id="e55" value="recusa volta à negociação" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n36" target="n26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="412"/></Array></mxGeometry></mxCell><mxCell id="e56" value="nº da apólice nova" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n26" target="n22"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1185" y="165"/></Array></mxGeometry></mxCell><mxCell id="n57" value="Medido e informado pelo time&lt;br&gt;• Tempo por apólice em tela: 3 minutos. Taxa de crítica: 20% das apólices e endossos. O lote é instantâneo (minutos). Não há métrica por seguradora." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="24" y="1134" width="2462" height="52" as="geometry"/></mxCell><mxCell id="n58" value="A confirmar&lt;br&gt;• Qual é o sistema de cotação (a tela com 90+ seletores) e o que ele devolve ao Fluid?&lt;br&gt;• Como o Fluid e o UiPath se falam: só API para anexos e protocolo, ou também tela? Onde roda o UiPath (Orchestrator, quantos robôs)?&lt;br&gt;• O agente de IA: qual modelo e onde roda? O Teams é um bot ou uma pessoa que chama?&lt;br&gt;• O Denodo entrega ao Dremio por conexão direta ou por uma carga? O que é CAS e como ele alimenta a Pioneira?&lt;br&gt;• Onde ficam as credenciais dos 5 portais e do sistema de cotação (cofre)?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="24" y="1202" width="2462" height="124" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
