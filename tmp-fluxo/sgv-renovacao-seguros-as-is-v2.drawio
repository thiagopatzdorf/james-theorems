<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="genesis-fluxo" version="1.0"><diagram id="fluxo" name="SGV · Renovação de seguros (residencial e auto) — AS IS v2"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="SGV · Renovação de seguros (residencial e auto) — AS IS v2" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="5472" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Versão 2, com as correções de 15/10/2026. Tudo roda por evento e em paralelo: as filas de baixa e de questionário não dependem uma da outra, e o agente de IA está fora da sequência. A crítica segue para o negócio, e o ano fecha um ciclo no Dremio. Tracejado em âmbar = manual. Pontos em &quot;A confirmar&quot; ainda não foram validados." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="24" y="50" width="5472" height="36" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="5520" height="110" as="geometry"/></mxCell><mxCell id="n5" value="Denodo (lake do CAS, alimenta a Pioneira)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="150" height="110" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="206" width="5520" height="110" as="geometry"/></mxCell><mxCell id="n7" value="Dremio" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="206" width="150" height="110" as="geometry"/></mxCell><mxCell id="n8" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="316" width="5520" height="137" as="geometry"/></mxCell><mxCell id="n9" value="Power BI" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="316" width="150" height="137" as="geometry"/></mxCell><mxCell id="n10" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="453" width="5520" height="110" as="geometry"/></mxCell><mxCell id="n11" value="Adri (assessora de seguros)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="453" width="150" height="110" as="geometry"/></mxCell><mxCell id="n12" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="563" width="5520" height="110" as="geometry"/></mxCell><mxCell id="n13" value="Operador" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="563" width="150" height="110" as="geometry"/></mxCell><mxCell id="n14" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="673" width="5520" height="152" as="geometry"/></mxCell><mxCell id="n15" value="Fluid · instâncias RPA" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="673" width="150" height="152" as="geometry"/></mxCell><mxCell id="n16" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="825" width="5520" height="200" as="geometry"/></mxCell><mxCell id="n17" value="Robô UiPath" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="825" width="150" height="200" as="geometry"/></mxCell><mxCell id="n18" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1025" width="5520" height="192" as="geometry"/></mxCell><mxCell id="n19" value="UiPath · filas" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1025" width="150" height="192" as="geometry"/></mxCell><mxCell id="n20" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1217" width="5520" height="122" as="geometry"/></mxCell><mxCell id="n21" value="Pasta de rede (UNC)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1217" width="150" height="122" as="geometry"/></mxCell><mxCell id="n22" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1339" width="5520" height="122" as="geometry"/></mxCell><mxCell id="n23" value="Agente de IA (independente, por evento)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1339" width="150" height="122" as="geometry"/></mxCell><mxCell id="n24" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1461" width="5520" height="110" as="geometry"/></mxCell><mxCell id="n25" value="Operação de negócio" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1461" width="150" height="110" as="geometry"/></mxCell><mxCell id="n26" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="1571" width="5520" height="122" as="geometry"/></mxCell><mxCell id="n27" value="Crítica" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="1571" width="150" height="122" as="geometry"/></mxCell><mxCell id="n28" value="Seguros efetivados no ano anterior ou renovados" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="178" y="116" width="190" height="71" as="geometry"/></mxCell><mxCell id="n29" value="Consome os dados do Denodo e entrega ao Power BI" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="226" width="175" height="71" as="geometry"/></mxCell><mxCell id="n30" value="Dash com os ~1.000 processos a vencer, cerca de 40 dias antes (auto e residencial, 5 seguradoras)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="595" y="334" width="175" height="101" as="geometry"/></mxCell><mxCell id="n31" value="Dia 20 abre o lote: importa os ~1.000 processos no Fluid" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="800" y="473" width="175" height="71" as="geometry"/></mxCell><mxCell id="n32" value="Processos abertos em RPA | Baixa de Apólices (prazo: tudo baixado e nas instâncias certas até dia 01)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1005" y="691" width="175" height="116" as="geometry"/></mxCell><mxCell id="n33" value="Aciona o robô alimentador (passo manual)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1210" y="583" width="175" height="71" as="geometry"/></mxCell><mxCell id="n34" value="Alimenta as 3 filas ao mesmo tempo com final da vigência, nome do segurado e seguradora" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1415" y="882" width="175" height="86" as="geometry"/></mxCell><mxCell id="n35" value="Seguradora é Porto Seguro e o produto é Auto?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="1613" y="870" width="190" height="110" as="geometry"/></mxCell><mxCell id="n36" value="Produto é Auto ou Residencial?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="1818" y="870" width="190" height="110" as="geometry"/></mxCell><mxCell id="n37" value="Fila BaixaApoliceRenovacaoSeguroAuto" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontSize=12;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#042F2E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2010" y="1043" width="215" height="71" as="geometry"/></mxCell><mxCell id="n38" value="Fila BaixaApoliceRenovacaoSeguroResidencial" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontSize=12;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#042F2E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2010" y="1128" width="215" height="71" as="geometry"/></mxCell><mxCell id="n39" value="Fila QuestionarioRenovacaoSeguros" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontSize=12;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#042F2E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1600" y="1089" width="215" height="64" as="geometry"/></mxCell><mxCell id="n40" value="Para cada item da fila: abre a tela da seguradora e baixa a apólice" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2235" y="882" width="175" height="86" as="geometry"/></mxCell><mxCell id="n41" value="Conseguiu baixar a apólice?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="2433" y="870" width="190" height="110" as="geometry"/></mxCell><mxCell id="n42" value="Tem endosso ou sinistro?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="2638" y="870" width="190" height="110" as="geometry"/></mxCell><mxCell id="n43" value="PDF salvo como &quot;Nome do segurado + Nº da apólice&quot; (endosso não é baixado)" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#052E16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2850" y="1235" width="175" height="86" as="geometry"/></mxCell><mxCell id="n44" value="Depois de baixar tudo: anexa o PDF da apólice no Fluid (via API)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3055" y="890" width="175" height="71" as="geometry"/></mxCell><mxCell id="n45" value="Achou os dados do ano passado (campo da apólice, URL do Fluid do ano anterior)?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="3253" y="848" width="190" height="154" as="geometry"/></mxCell><mxCell id="n46" value="Extrai o PDF de dados do processo do ano anterior e anexa no Fluid" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3465" y="843" width="175" height="86" as="geometry"/></mxCell><mxCell id="n47" value="Anexa um PDF em branco no Fluid" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3465" y="943" width="175" height="64" as="geometry"/></mxCell><mxCell id="n48" value="Protocola o Fluid para RPA | Cotação de Seguros" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3670" y="890" width="175" height="71" as="geometry"/></mxCell><mxCell id="n49" value="A cada item da fila: lê a apólice e o PDF e monta o questionário de 15 perguntas" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1825" y="1357" width="175" height="86" as="geometry"/></mxCell><mxCell id="n50" value="Questionário de 15 perguntas pronto" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2023" y="1368" width="190" height="64" as="geometry"/></mxCell><mxCell id="n51" value="RPA | Cotação de Seguros: robô preenche a cotação em tela (90+ seletores; regras fixas, Fluid e apólice)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3875" y="691" width="175" height="116" as="geometry"/></mxCell><mxCell id="n52" value="Cotação concluída com sucesso?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="4073" y="694" width="190" height="110" as="geometry"/></mxCell><mxCell id="n53" value="RPA | Aviso de Renovação: WhatsApp avisa que faltam 10 dias e pergunta se quer renovar (sem robô)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="4285" y="691" width="175" height="116" as="geometry"/></mxCell><mxCell id="n54" value="Operação manual de negócio" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="4490" y="1484" width="175" height="64" as="geometry"/></mxCell><mxCell id="n55" value="RPA | Envio Assinaturas (sem robô)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="4695" y="717" width="175" height="64" as="geometry"/></mxCell><mxCell id="n56" value="RPA | Monitoramento Assinaturas (sem robô)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="4900" y="717" width="175" height="64" as="geometry"/></mxCell><mxCell id="n57" value="RPA | Emissão de Apólices: aguarda a emissão, salva o nº da apólice nova no Fluid e encerra o processo" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="5105" y="699" width="175" height="101" as="geometry"/></mxCell><mxCell id="n58" value="O nº da apólice nova entra no Dremio" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="5310" y="229" width="175" height="64" as="geometry"/></mxCell><mxCell id="n59" value="Processo enviado para a crítica (a instância de Cotação está parada por crítica hoje)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEE2E2;strokeColor=#B91C1C;fontColor=#450A0A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="4285" y="1589" width="175" height="86" as="geometry"/></mxCell><mxCell id="e60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n29" target="n30"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e62" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#334155;strokeWidth=2;fontSize=12;fontStyle=1;fontColor=#0F172A;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entry