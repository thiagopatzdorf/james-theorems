<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="genesis-fluxo" version="1.0"><diagram id="fluxo" name="SGV · Renovação de seguros (residencial e auto) — AS IS v6"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="SGV · Renovação de seguros (residencial e auto) — AS IS v6" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="24" y="12" width="6082" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Versão 6, com as correções e as métricas informadas em 15/10/2026. Tudo roda por evento e em paralelo. O Operador Seguros chama o agente de IA no Teams, conduz a negociação (WhatsApp ou ligação) e, se a emissão demorar ou a vistoria recusar, o processo volta para a negociação: é aí que o fluxo fica circular. Tracejado em âmbar = manual; seta tracejada cinza = dado que a pessoa pega no Fluid. Pontos em &quot;A confirmar&quot; ainda não foram validados." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="24" y="50" width="6082" height="36" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="6130" height="110" as="geometry"/></mxCell><mxCell id="n5" value="Denodo (lake do CAS, alimenta a Pioneira)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="96" width="150" height="110" as="geometry"/></mxCell><mxCell id="n6" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="206" width="6130" height="110" as="geometry"/></mxCell><mxCell id="n7" value="Dremio" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="206" width="150" height="110" as="geometry"/></mxCell><mxCell id="n8" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="316" width="6130" height="137" as="geometry"/></mxCell><mxCell id="n9" value="Power BI" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="316" width="150" height="137" as="geometry"/></mxCell><mxCell id="n10" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="453" width="6130" height="137" as="geometry"/></mxCell><mxCell id="n11" value="Adri (assessora de seguros)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="453" width="150" height="137" as="geometry"/></mxCell><mxCell id="n12" value="" style="rounded=0;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="590" width="6130" height="110" as="geometry"/></mxCell><mxCell id="n13" value="Operador RPA (start manual)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="590" width="150" height="110" as="geometry"/></mxCell><mxCell id="n14" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="700" width="6130" height="152" as="geometry"/></mxCell><mxCell id="n15" value="Fluid · Baixa, Cotação e Aviso" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="700" width="150" height="152" as="geometry"/