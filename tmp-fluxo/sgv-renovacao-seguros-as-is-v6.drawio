or=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="2063" width="150" height="160" as="geometry"/></mxCell><mxCell id="n34" value="" style="rounded=0;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;" vertex="1" parent="1"><mxGeometry x="0" y="2223" width="6130" height="152" as="geometry"/></mxCell><mxCell id="n35" value="Crítica" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#E2E8F0;strokeColor=#CBD5E1;fontSize=13;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="0" y="2223" width="150" height="152" as="geometry"/></mxCell><mxCell id="n36" value="Seguros efetivados no ano anterior ou renovados" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontSize=12;fillColor=#0F172A;strokeColor=#0F172A;fontColor=#FFFFFF;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="185" y="116" width="190" height="71" as="geometry"/></mxCell><mxCell id="n37" value="Consome os dados do Denodo e entrega ao Power BI" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="413" y="226" width="175" height="71" as="geometry"/></mxCell><mxCell id="n38" value="Dash com os ~1.000 processos a vencer, cerca de 40 dias antes (auto e residencial, 5 seguradoras)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="633" y="334" width="175" height="101" as="geometry"/></mxCell><mxCell id="n39" value="Dia 20 abre o lote: importa os ~1.000 processos no Fluid (instantâneo, em minutos)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="853" y="471" width="175" height="101" as="geometry"/></mxCell><mxCell id="n40" value="Processos abertos em RPA | Baixa de Apólices (prazo: tudo baixado e nas instâncias certas até dia 01)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1073" y="718" width="175" height="116" as="geometry"/></mxCell><mxCell id="n41" value="Aciona o robô alimentador (passo manual)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;strokeColor=#B45309;fontColor=#3B2200;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1293" y="610" width="175" height="71" as="geometry"/></mxCell><mxCell id="n42" value="Alimenta as 3 filas ao mesmo tempo com final da vigência, nome do segurado, seguradora e nº da apólice do ano anterior" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1513" y="870" width="175" height="116" as="geometry"/></mxCell><mxCell id="n43" value="Seguradora é Porto Seguro e o produto é Auto?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="1725" y="873" width="190" height="110" as="geometry"/></mxCell><mxCell id="n44" value="Produto é Auto ou Residencial?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="1945" y="873" width="190" height="110" as="geometry"/></mxCell><mxCell id="n45" value="Fila BaixaApoliceRenovacaoSeguroAuto" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontSize=12;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#042F2E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2165" y="1022" width="190" height="71" as="geometry"/></mxCell><mxCell id="n46" value="Fila BaixaApoliceRenovacaoSeguroResidencial" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontSize=12;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#042F2E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2165" y="1107" width="190" height="71" as="geometry"/></mxCell><mxCell id="n47" value="Fila QuestionarioRenovacaoSeguros (dados do ano passado)" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontSize=12;fillColor=#CCFBF1;strokeColor=#0F766E;fontColor=#042F2E;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1725" y="1057" width="190" height="86" as="geometry"/></mxCell><mxCell id="n48" value="Para cada item da fila: abre a tela da seguradora e baixa a apólice (≈3 min por apólice em tela)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2393" y="1219" width="175" height="101" as="geometry"/></mxCell><mxCell id="n49" value="Conseguiu baixar a apólice?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="2605" y="1214" width="190" height="110" as="geometry"/></mxCell><mxCell id="n50" value="Tem endosso ou sinistro?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="2825" y="1214" width="190" height="110" as="geometry"/></mxCell><mxCell id="n51" value="PDF salvo como &quot;Nome do segurado + Nº da apólice&quot; (endosso não é baixado)" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fontSize=12;fillColor=#DCFCE7;strokeColor=#15803D;fontColor=#052E16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3053" y="1560" width="175" height="86" as="geometry"/></mxCell><mxCell id="n52" value="Depois de baixar tudo: anexa o PDF da apólice no Fluid (via API)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3273" y="1234" width="175" height="71" as="geometry"/></mxCell><mxCell id="n53" value="Para cada item da fila: lê o campo da apólice com os dados do ano passado (URL do Fluid do ano anterior)" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1953" y="1392" width="175" height="101" as="geometry"/></mxCell><mxCell id="n54" value="Achou o processo do ano anterior?" style="rhombus;html=1;whiteSpace=wrap;fontSize=12;fillColor=#EDE9FE;strokeColor=#6D28D9;fontColor=#2E1065;strokeWidth=2;spacingLeft=24;spacingRight=24;" vertex="1" parent="1"><mxGeometry x="2165" y="1387" width="190" height="110" as="geometry"/></mxCell><mxCell id="n55" value="Extrai o PDF de dados do processo do ano anterior e anexa no Fluid" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2393" y="1360" width="175" height="86" as="geometry"/></mxCell><mxCell id="n56" value="Anexa um PDF em branco no Fluid" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2393" y="1460" width="175" height="64" as="geometry"/></mxCell><mxCell id="n57" value="Protocola o Fluid para RPA | Cotação de Seguros" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#E0F2FE;strokeColor=#0369A1;fontColor=#0C2A40;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="3493" y="1234" width="175" height="71" as="geometry"/></mxCell><mxCell id="n58" value="Chama o agente de IA no Teams e envia o PDF e o questionário" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fontSize=12;fillColor=#FEF3C7;